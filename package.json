{
	"name": "@vdegenne/kokoro",
	"version": "0.1.28",
	"description": "Client helper to interact with Kokoro TTS server.",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vdegenne/kokoro.git"
	},
	"homepage": "https://github.com/vdegenne/kokoro#readme",
	"bugs": {
		"url": "https://github.com/vdegenne/kokoro/issues"
	},
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.js"
		},
		"./core": {
			"types": "./lib/core.d.ts",
			"import": "./lib/core.js"
		}
	},
	"files": [
		"lib"
	],
	"scripts": {
		"build": "wireit"
	},
	"wireit": {
		"build": {
			"command": "tsc --pretty",
			"clean": "if-file-deleted",
			"files": [
				"./tsconfig.json",
				"./src"
			],
			"output": [
				"./lib"
			]
		}
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"wireit": "^0.14.13"
	}
}
